# Copy to /etc/opentype/server.env, chmod 600; never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=9100
DB_PATH=/var/lib/opentype/opentype.db
# Set once using: openssl rand -hex 32. Preserve it across restarts.
JWT_SECRET=
# Only the local Caddy reverse proxy may supply X-Real-IP.
TRUST_PROXY=loopback
ALLOW_DEV_EMAIL_CODES=false
# Public site key and private server-only secret for the www.opentype.top widget.
# Production refuses to start without both; TURNSTILE_REQUIRED=false only works in development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional HTTP email gateway accepting JSON {from,to,subject,text}.
# Set a verified sender address and a real HTTPS endpoint before enabling codes.
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
# Accounts and synchronization need no ASR or LLM credentials.
ENABLE_REFINE=false
