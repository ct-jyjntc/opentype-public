# Optional legacy HTTP adapter. The desktop uses built-in SenseVoice Small.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
ASR_URL=http://127.0.0.1:8080

# Optional text refinement; provide your own credentials only in an ignored .env.
LLM_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
ENABLE_REFINE=false
REFINE_FALLBACK=true
